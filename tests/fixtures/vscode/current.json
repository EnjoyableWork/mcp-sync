{
  "inputs": [
    {
      "type": "promptString",
      "id": "fixture-api-key",
      "description": "Synthetic API key",
      "password": true
    }
  ],
  "sandbox": {
    "filesystem": {
      "allowWrite": ["${workspaceFolder}/generated"]
    },
    "network": {
      "allowedDomains": ["fixture.example.invalid"]
    }
  },
  "servers": {
    "unchanged": {
      "type": "stdio",
      "command": "/synthetic/bin/unchanged",
      "args": ["--mode", "safe"],
      "env": {
        "UNCHANGED_TOKEN": "fixture-vscode-unchanged-secret"
      },
      "cwd": "${workspaceFolder}",
      "sandboxEnabled": true
    },
    "updated": {
      "command": "/synthetic/bin/old",
      "args": ["--old"],
      "env": {
        "KEEP": "same",
        "REMOVE": "fixture-vscode-remove-secret",
        "ROTATE": "fixture-vscode-old-secret"
      },
      "envFile": "${userHome}/.synthetic-vscode.env",
      "dev": {
        "watch": "src/**/*.ts"
      }
    },
    "target-only": {
      "type": "stdio",
      "command": "/synthetic/bin/local",
      "args": ["--local"],
      "env": {
        "LOCAL_TOKEN": "fixture-vscode-local-secret"
      },
      "cwd": "/synthetic/target-only"
    },
    "remote-only": {
      "type": "http",
      "url": "https://vscode.example.invalid/mcp",
      "headers": {
        "Authorization": "Bearer fixture-vscode-remote-secret"
      },
      "oauth": {
        "clientId": "fixture-client-id"
      }
    },
    "numeric-env": {
      "type": "stdio",
      "command": "/synthetic/bin/native-env",
      "args": ["--native"],
      "env": {
        "OPTIONAL": null,
        "PORT": 3000
      },
      "futureOption": {
        "preserve": true
      }
    }
  },
  "futureTopLevel": {
    "nested": ["preserve", 11, true],
    "preciseNumber": 1234567890123456789012345678901234567890
  }
}
