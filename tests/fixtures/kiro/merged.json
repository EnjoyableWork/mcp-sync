{
  // Kiro global-user fixture comment
  "futureTopLevel": {
    "nested": ["preserve", 13, true],
    "preciseNumber": 1234567890123456789012345678901234567890
  },
  "mcpServers": {
    // compatible local entries are owned only at command, args, and env
    "unchanged": {
      "command": "/synthetic/bin/unchanged",
      "args": ["--mode", "safe"],
      "env": {
        "UNCHANGED_TOKEN": "fixture-kiro-unchanged-secret"
      },
      "cwd": "/synthetic/kiro/unchanged",
      "disabled": false
    },
    "updated": {
      "command": "/synthetic/bin/new",
      "args": ["--new", "two"],
      "env": {
        "ADDED": "fixture-kiro-added-environment-secret",
        "KEEP": "same",
        "ROTATE": "fixture-kiro-new-secret"
      },
      "cwd": "/synthetic/kiro/preserved",
      "autoApprove": ["read"],
      "disabledTools": ["write"],
      "futureOption": {
        "enabled": true
      }
    },
    "target-only": {
      "command": "/synthetic/bin/local",
      "args": ["--local"],
      "env": {
        "LOCAL_TOKEN": "fixture-kiro-local-secret"
      },
      "disabled": true
    },
    "remote-only": {
      "url": "https://kiro.example.invalid/mcp",
      "headers": {
        "Authorization": "Bearer fixture-kiro-remote-secret"
      },
      "oauth": {
        "clientId": "fixture-kiro-client-id"
      },
      "oauthScopes": ["fixture:read"]
    },
    "reference-only": {
      "command": "${KIRO_FIXTURE_RUNNER}",
      "args": ["--token=${KIRO_FIXTURE_ARGUMENT}"],
      "env": {
        "TOKEN": "${KIRO_FIXTURE_TOKEN}"
      },
      "disabled": true
    },
    "numeric-env": {
      "command": "/synthetic/bin/native-env",
      "env": {
        "OPTIONAL": null,
        "PORT": 43117
      },
      "futureOption": {
        "preserve": true
      }
    },
    "added": {
      "command": "/synthetic/bin/added",
      "args": ["--new"],
      "env": {
        "ADD_TOKEN": "fixture-kiro-added-secret"
      }
    },
  },
}
