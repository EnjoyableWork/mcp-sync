{
  "schemaVersion": 1,
  "servers": {
    "added": {
      "command": "/synthetic/bin/added",
      "args": ["--new"],
      "env": {
        "ADD_TOKEN": "fixture-kiro-added-secret"
      }
    },
    "unchanged": {
      "command": "/synthetic/bin/unchanged",
      "args": ["--mode", "safe"],
      "env": {
        "UNCHANGED_TOKEN": "fixture-kiro-unchanged-secret"
      }
    },
    "updated": {
      "command": "/synthetic/bin/new",
      "args": ["--new", "two"],
      "env": {
        "ADDED": "fixture-kiro-added-environment-secret",
        "KEEP": "same",
        "ROTATE": "fixture-kiro-new-secret"
      }
    }
  }
}
